generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  OWNER
  FACTORY_ADMIN
  PRODUCTION_SUPERVISOR
  SALESMAN
  ACCOUNTANT
}

enum CustomerType {
  RETAILER
  DISTRIBUTOR
}

enum PriceCategory {
  STANDARD
  WHOLESALE
  DISTRIBUTOR
}

enum BaseUnit {
  GRAM
  ML
  PIECE
}

enum BomItemType {
  RAW_MATERIAL
  PACKAGING_MATERIAL
}

enum BomUsageMode {
  PER_BATCH
  PER_GOOD_PACKET
  MANUAL_PER_RUN
}

enum ProductionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ExpenseCategory {
  LABOUR
  GAS_ELECTRICITY
  MAINTENANCE
  OTHER
}

enum OrderStatus {
  SUBMITTED
  VERIFIED
  APPROVED
  REJECTED
  INVOICED
  DISPATCHED
  CANCELLED
}

enum InvoiceStatus {
  POSTED
  CANCELLED
}

enum PaymentMode {
  CASH
  UPI
  NEFT
  RTGS
  CHEQUE
}

enum StockItemCategory {
  RAW_MATERIAL
  PACKAGING_MATERIAL
  FINISHED_GOOD
}

enum StockMovementType {
  OPENING
  PURCHASE_RECEIPT
  MATERIAL_ISSUE
  PRODUCTION_RECEIPT
  SALES_DISPATCH
  ADJUSTMENT
}

enum StockDirection {
  IN
  OUT
}

model Role {
  id          String   @id @default(cuid())
  code        RoleCode @unique
  name        String
  description String?
  users       User[]
  createdAt   DateTime @default(now())
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedCustomers Customer[]      @relation("CustomerSalesman")
  salesOrders       SalesOrder[]    @relation("OrderSalesman")
  verifiedOrders    SalesOrder[]    @relation("OrderVerifiedBy")
  approvedOrders    SalesOrder[]    @relation("OrderApprovedBy")
  dispatchedOrders  SalesOrder[]    @relation("OrderDispatchedBy")
  productionRuns    ProductionRun[] @relation("RunSupervisor")
  materialIssues    MaterialIssue[]
  purchases         Purchase[]
  invoices          Invoice[]
  payments          Payment[]
  expenses          Expense[]
  stockMovements    StockMovement[]
  auditLogs         AuditLog[]

  @@index([roleId])
}

model CompanySetting {
  id                              String   @id @default("default")
  companyName                     String   @default("SavorSouth Foods")
  tagline                         String   @default("Tradition in Every Bite.")
  gstin                           String   @default("33AABCS1429B1Z5")
  fssaiLicense                    String   @default("12423008001924")
  address                         String   @default("Plot 42, SIDCO Industrial Estate, Thuvakudi")
  city                            String   @default("Tiruchirappalli")
  state                           String   @default("Tamil Nadu")
  stateCode                       String   @default("33")
  phone                           String   @default("+91 431 250 4820")
  email                           String   @default("accounts@savorsouthfoods.in")
  invoicePrefix                   String   @default("SSF")
  yieldVarianceTolerancePct       Float    @default(5.0)
  consumptionVarianceTolerancePct Float    @default(5.0)
  overheadAllocationRule          String   @default("Direct Batch Assignment: 100% of direct batch labour and gas/electricity overheads are allocated equally across actual good packets produced in that batch.")
  defaultLabourCostPerBatchPaisa  BigInt   @default(120000)
  defaultGasPowerCostPerBatchPaisa BigInt  @default(60000)
  updatedAt                       DateTime @updatedAt
}

model Customer {
  id                 String        @id @default(cuid())
  name               String
  type               CustomerType  @default(RETAILER)
  gstin              String?
  address            String
  city               String
  state              String
  stateCode          String
  phone              String
  email              String?
  priceCategory      PriceCategory @default(STANDARD)
  creditLimitPaisa   BigInt        @default(5000000)
  assignedSalesmanId String?
  assignedSalesman   User?         @relation("CustomerSalesman", fields: [assignedSalesmanId], references: [id])
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  salesOrders SalesOrder[]
  invoices    Invoice[]
  payments    Payment[]

  @@index([assignedSalesmanId])
  @@index([stateCode])
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  gstin     String?
  address   String
  city      String
  state     String
  stateCode String
  phone     String
  email     String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  purchases Purchase[]
}

model Product {
  id                  String   @id @default(cuid())
  name                String
  sku                 String   @unique
  category            String
  packSizeGrams       Int
  packLabel           String
  sellingPricePaisa   BigInt
  gstRateBps          Int      @default(500)
  hsnCode             String
  unit                String   @default("PACKET")
  packetsPerCarton    Int      @default(20)
  openingStockPackets Int      @default(0)
  currentStockPackets Int      @default(0)
  reorderLevelPackets Int      @default(50)
  imageUrl            String?
  description         String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  boms            Bom[]
  productionRuns  ProductionRun[]
  salesOrderItems SalesOrderItem[]
  invoiceItems    InvoiceItem[]
  stockMovements  StockMovement[]

  @@index([category])
}

model RawMaterial {
  id               String   @id @default(cuid())
  name             String
  code             String   @unique
  displayUnit      String
  baseUnit         BaseUnit
  reorderLevelBase BigInt   @default(0)
  openingStockBase BigInt   @default(0)
  openingRatePaisa BigInt   @default(0)
  currentStockBase BigInt   @default(0)
  totalValuePaisa  BigInt   @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bomItems       BomItem[]
  purchaseItems  PurchaseItem[]
  materialIssues MaterialIssue[]
  stockMovements StockMovement[]
}

model PackagingMaterial {
  id               String   @id @default(cuid())
  name             String
  code             String   @unique
  displayUnit      String
  baseUnit         BaseUnit @default(PIECE)
  reorderLevelBase BigInt   @default(0)
  openingStockBase BigInt   @default(0)
  openingRatePaisa BigInt   @default(0)
  currentStockBase BigInt   @default(0)
  totalValuePaisa  BigInt   @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bomItems       BomItem[]
  purchaseItems  PurchaseItem[]
  materialIssues MaterialIssue[]
  stockMovements StockMovement[]
}

model Bom {
  id                      String   @id @default(cuid())
  productId               String
  product                 Product  @relation(fields: [productId], references: [id])
  version                 Int      @default(1)
  name                    String
  expectedOutputPackets   Int
  yieldTolerancePct       Float    @default(5.0)
  consumptionTolerancePct Float    @default(5.0)
  notes                   String?
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  items          BomItem[]
  productionRuns ProductionRun[]

  @@unique([productId, version])
  @@index([productId])
}

model BomItem {
  id                  String             @id @default(cuid())
  bomId               String
  bom                 Bom                @relation(fields: [bomId], references: [id], onDelete: Cascade)
  itemType            BomItemType
  rawMaterialId       String?
  rawMaterial         RawMaterial?       @relation(fields: [rawMaterialId], references: [id])
  packagingMaterialId String?
  packagingMaterial   PackagingMaterial? @relation(fields: [packagingMaterialId], references: [id])
  quantity            Float
  unit                String
  quantityBase        BigInt
  usageMode           BomUsageMode       @default(PER_BATCH)

  @@index([bomId])
}

model Purchase {
  id               String         @id @default(cuid())
  purchaseNumber   String         @unique
  supplierId       String
  supplier         Supplier       @relation(fields: [supplierId], references: [id])
  supplierBillNo   String?
  purchaseDate     DateTime       @default(now())
  subtotalPaisa    BigInt
  gstPaisa         BigInt         @default(0)
  totalAmountPaisa BigInt
  notes            String?
  createdById      String
  createdBy        User           @relation(fields: [createdById], references: [id])
  createdAt        DateTime       @default(now())

  items PurchaseItem[]

  @@index([supplierId])
  @@index([purchaseDate])
}

model PurchaseItem {
  id                  String             @id @default(cuid())
  purchaseId          String
  purchase            Purchase           @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  itemType            BomItemType
  rawMaterialId       String?
  rawMaterial         RawMaterial?       @relation(fields: [rawMaterialId], references: [id])
  packagingMaterialId String?
  packagingMaterial   PackagingMaterial? @relation(fields: [packagingMaterialId], references: [id])
  quantity            Float
  unit                String
  quantityBase        BigInt
  ratePaisa           BigInt
  gstRateBps          Int                @default(0)
  lineTotalPaisa      BigInt

  @@index([purchaseId])
}

model ProductionRun {
  id                    String           @id @default(cuid())
  runNumber             String           @unique
  batchNumber           String           @unique
  bomId                 String
  bom                   Bom              @relation(fields: [bomId], references: [id])
  productId             String
  product               Product          @relation(fields: [productId], references: [id])
  batchSize             Float            @default(1)
  status                ProductionStatus @default(IN_PROGRESS)
  productionDate        DateTime         @default(now())
  supervisorId          String
  supervisor            User             @relation("RunSupervisor", fields: [supervisorId], references: [id])
  expectedOutputPackets Int
  actualGoodPackets     Int              @default(0)
  damagedPacketsCount   Int              @default(0)
  wastageKg             Float            @default(0)
  yieldVariancePct      Float            @default(0)
  yieldAlertTriggered   Boolean          @default(false)
  rawMaterialCostPaisa  BigInt           @default(0)
  packagingCostPaisa    BigInt           @default(0)
  labourCostPaisa       BigInt           @default(0)
  gasPowerCostPaisa     BigInt           @default(0)
  totalCostPaisa        BigInt           @default(0)
  costPerPacketPaisa    BigInt           @default(0)
  notes                 String?
  completedAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  materialIssues MaterialIssue[]
  expenses       Expense[]

  @@index([productId])
  @@index([productionDate])
  @@index([status])
}

model MaterialIssue {
  id                  String             @id @default(cuid())
  productionRunId     String
  productionRun       ProductionRun      @relation(fields: [productionRunId], references: [id], onDelete: Cascade)
  itemType            BomItemType
  rawMaterialId       String?
  rawMaterial         RawMaterial?       @relation(fields: [rawMaterialId], references: [id])
  packagingMaterialId String?
  packagingMaterial   PackagingMaterial? @relation(fields: [packagingMaterialId], references: [id])
  plannedQtyBase      BigInt
  issuedQtyBase       BigInt
  damagedQtyBase      BigInt             @default(0)
  unit                String
  displayPlannedQty   Float
  displayIssuedQty    Float
  displayDamagedQty   Float              @default(0)
  variancePct         Float              @default(0)
  alertTriggered      Boolean            @default(false)
  unitCostPaisa       BigInt             @default(0)
  totalCostPaisa      BigInt             @default(0)
  issuedById          String
  issuedBy            User               @relation(fields: [issuedById], references: [id])
  issuedAt            DateTime           @default(now())

  @@index([productionRunId])
}

model Expense {
  id              String          @id @default(cuid())
  productionRunId String?
  productionRun   ProductionRun?  @relation(fields: [productionRunId], references: [id])
  category        ExpenseCategory
  description     String
  amountPaisa     BigInt
  expenseDate     DateTime        @default(now())
  recordedById    String
  recordedBy      User            @relation(fields: [recordedById], references: [id])
  createdAt       DateTime        @default(now())

  @@index([productionRunId])
  @@index([expenseDate])
}

model SalesOrder {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  customerId        String
  customer          Customer    @relation(fields: [customerId], references: [id])
  salesmanId        String
  salesman          User        @relation("OrderSalesman", fields: [salesmanId], references: [id])
  status            OrderStatus @default(SUBMITTED)
  orderDate         DateTime    @default(now())
  subtotalPaisa     BigInt
  estimatedTaxPaisa BigInt
  totalAmountPaisa  BigInt
  hasStockShortage  Boolean     @default(false)
  rejectionReason   String?
  notes             String?
  verifiedById      String?
  verifiedBy        User?       @relation("OrderVerifiedBy", fields: [verifiedById], references: [id])
  approvedById      String?
  approvedBy        User?       @relation("OrderApprovedBy", fields: [approvedById], references: [id])
  dispatchedById    String?
  dispatchedBy      User?       @relation("OrderDispatchedBy", fields: [dispatchedById], references: [id])
  dispatchedAt      DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  items   SalesOrderItem[]
  invoice Invoice?

  @@index([customerId])
  @@index([salesmanId])
  @@index([status])
  @@index([orderDate])
}

model SalesOrderItem {
  id                String     @id @default(cuid())
  salesOrderId      String
  salesOrder        SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product    @relation(fields: [productId], references: [id])
  quantityPackets   Int
  unit              String     @default("PACKET")
  unitPricePaisa    BigInt
  gstRateBps        Int
  lineSubtotalPaisa BigInt
  lineTaxPaisa      BigInt
  lineTotalPaisa    BigInt

  @@index([salesOrderId])
  @@index([productId])
}

model Invoice {
  id                 String        @id @default(cuid())
  invoiceNumber      String        @unique
  financialYear      String
  salesOrderId       String        @unique
  salesOrder         SalesOrder    @relation(fields: [salesOrderId], references: [id])
  customerId         String
  customer           Customer      @relation(fields: [customerId], references: [id])
  invoiceDate        DateTime      @default(now())
  status             InvoiceStatus @default(POSTED)
  isInterState       Boolean
  taxableAmountPaisa BigInt
  cgstPaisa          BigInt
  sgstPaisa          BigInt
  igstPaisa          BigInt
  totalAmountPaisa   BigInt
  paidAmountPaisa    BigInt        @default(0)
  cancelledAt        DateTime?
  cancellationReason String?
  creditNoteNumber   String?
  createdById        String
  createdBy          User          @relation(fields: [createdById], references: [id])
  createdAt          DateTime      @default(now())

  items       InvoiceItem[]
  allocations PaymentAllocation[]

  @@index([customerId])
  @@index([invoiceDate])
  @@index([financialYear])
}

model InvoiceItem {
  id                 String  @id @default(cuid())
  invoiceId          String
  invoice            Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId          String
  product            Product @relation(fields: [productId], references: [id])
  productName        String
  hsnCode            String
  quantityPackets    Int
  unitPricePaisa     BigInt
  taxableAmountPaisa BigInt
  gstRateBps         Int
  cgstPaisa          BigInt
  sgstPaisa          BigInt
  igstPaisa          BigInt
  totalAmountPaisa   BigInt

  @@index([invoiceId])
}

model Payment {
  id              String      @id @default(cuid())
  paymentNumber   String      @unique
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id])
  paymentDate     DateTime    @default(now())
  amountPaisa     BigInt
  paymentMode     PaymentMode @default(NEFT)
  referenceNumber String?
  notes           String?
  recordedById    String
  recordedBy      User        @relation(fields: [recordedById], references: [id])
  createdAt       DateTime    @default(now())

  allocations PaymentAllocation[]

  @@index([customerId])
  @@index([paymentDate])
}

model PaymentAllocation {
  id                   String   @id @default(cuid())
  paymentId            String
  payment              Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId            String
  invoice              Invoice  @relation(fields: [invoiceId], references: [id])
  allocatedAmountPaisa BigInt
  createdAt            DateTime @default(now())

  @@index([paymentId])
  @@index([invoiceId])
}

model StockMovement {
  id                  String             @id @default(cuid())
  movementNumber      String             @unique
  itemCategory        StockItemCategory
  rawMaterialId       String?
  rawMaterial         RawMaterial?       @relation(fields: [rawMaterialId], references: [id])
  packagingMaterialId String?
  packagingMaterial   PackagingMaterial? @relation(fields: [packagingMaterialId], references: [id])
  productId           String?
  product             Product?           @relation(fields: [productId], references: [id])
  movementType        StockMovementType
  direction           StockDirection
  quantityBase        BigInt
  unitLabel           String
  unitCostPaisa       BigInt             @default(0)
  totalValuePaisa     BigInt             @default(0)
  balanceAfterBase    BigInt
  sourceDocType       String
  sourceDocId         String
  sourceDocNumber     String
  notes               String?
  createdById         String
  createdBy           User               @relation(fields: [createdById], references: [id])
  createdAt           DateTime           @default(now())

  @@index([itemCategory])
  @@index([rawMaterialId])
  @@index([packagingMaterialId])
  @@index([productId])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  userRole    String?
  action      String
  entityType  String
  entityId    String
  entityLabel String?
  beforeState Json?
  afterState  Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
