{
  "name": "savorsouth-erp",
  "version": "1.0.0",
  "private": true,
  "description": "SavorSouth Foods ERP - Order-to-Audit Management System for South Indian Snacks Manufacturing",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "test": "npm --prefix backend test",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed": "npm --prefix backend run db:seed",
    "db:embedded": "npm --prefix backend run db:embedded"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
